{
  "$defs": {
    "AttributionTag": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "AttributionTag",
      "type": "object"
    },
    "AwsIdentityTable": {
      "additionalProperties": false,
      "description": "Which roles are people's, and which roles are known not to be.\n\nTwo lists rather than one with a flag, because they are read at different points: the\nfirst is a join and the second is a subtraction, and a row that is in both is a person\nwhose launches vanish. :class:`~edullm_platform.contracts.inventory.OrganizationInventory`\nrefuses that.",
      "properties": {
        "excluded_roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExcludedRole"
          },
          "title": "Excluded Roles",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AwsRoleBinding"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "title": "AwsIdentityTable",
      "type": "object"
    },
    "AwsRoleBinding": {
      "additionalProperties": false,
      "description": "One AWS role name, and the roster login whose launches it makes.\n\nThis is the only place a person's AWS identity is written down anywhere in this platform.\nNothing else can supply it: the role tag reads the same on every role in the account, the\nOIDC subject is an email address and the roster is keyed on GitHub logins, and a session\ntag is exactly what an off-platform launch does not carry.",
      "properties": {
        "github_login": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Github Login",
          "type": "string"
        },
        "role_name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+=,.@_-]{1,64}$",
          "title": "Role Name",
          "type": "string"
        }
      },
      "required": [
        "role_name",
        "github_login"
      ],
      "title": "AwsRoleBinding",
      "type": "object"
    },
    "ExcludedRole": {
      "additionalProperties": false,
      "description": "One role name whose launches are not a person's, and why.\n\nLITERAL, NEVER A PATTERN, AND THE REASON IS A FIELD RATHER THAN A COMMENT. A prefix here\nwould silently swallow the next role that happens to match it, which is the same class of\nfailure as a missing binding and harder to see, because a role nobody added still\ndisappears. A reason is required because an exclusion is a decision to stop looking at\nsomething, and one with no reason beside it cannot be re-judged later.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "role_name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+=,.@_-]{1,64}$",
          "title": "Role Name",
          "type": "string"
        }
      },
      "required": [
        "role_name",
        "reason"
      ],
      "title": "ExcludedRole",
      "type": "object"
    },
    "PersonRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "github_login": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Github Login",
          "type": "string"
        },
        "wandb_username": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wandb Username"
        }
      },
      "required": [
        "github_login"
      ],
      "title": "PersonRef",
      "type": "object"
    },
    "RepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "permitted_team_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Team Ids",
          "type": "array"
        },
        "repository": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "permitted_team_ids"
      ],
      "title": "RepositoryBinding",
      "type": "object"
    },
    "TeamBinding": {
      "additionalProperties": false,
      "properties": {
        "allowed_compute_profiles": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Compute Profiles",
          "type": "array"
        },
        "attribution_tags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttributionTag"
          },
          "title": "Attribution Tags",
          "type": "array"
        },
        "github_team_slug": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Github Team Slug",
          "type": "string"
        },
        "lead_logins": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string"
          },
          "title": "Lead Logins",
          "type": "array"
        },
        "member_logins": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string"
          },
          "title": "Member Logins",
          "type": "array"
        },
        "s3_namespace": {
          "pattern": "^sbsandbox-intern-[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9._-]*)*$",
          "title": "S3 Namespace",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Team Id",
          "type": "string"
        },
        "wandb_entity": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Wandb Entity",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "github_team_slug",
        "s3_namespace",
        "wandb_entity"
      ],
      "title": "TeamBinding",
      "type": "object"
    },
    "TeamBindingCatalog": {
      "additionalProperties": false,
      "properties": {
        "repositories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RepositoryBinding"
          },
          "title": "Repositories",
          "type": "array"
        },
        "teams": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TeamBinding"
          },
          "title": "Teams",
          "type": "array"
        }
      },
      "title": "TeamBindingCatalog",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "admins": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Admins",
      "type": "array"
    },
    "aws_identities": {
      "$ref": "#/$defs/AwsIdentityTable",
      "default": {
        "excluded_roles": [],
        "roles": []
      }
    },
    "members": {
      "items": {
        "$ref": "#/$defs/PersonRef"
      },
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "pilot_repositories": {
      "items": {
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Pilot Repositories",
      "type": "array"
    },
    "team_bindings": {
      "$ref": "#/$defs/TeamBindingCatalog",
      "default": {
        "repositories": [],
        "teams": []
      }
    },
    "team_leads": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Team Leads",
      "type": "array"
    }
  },
  "required": [
    "admins",
    "team_leads",
    "members",
    "pilot_repositories"
  ],
  "title": "OrganizationInventory",
  "type": "object"
}
