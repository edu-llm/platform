{
  "$defs": {
    "CheckpointContract": {
      "additionalProperties": false,
      "properties": {
        "destination_prefix": {
          "pattern": "^s3://sbsandbox-intern-[a-z0-9](?:[a-z0-9.-]{0,44}[a-z0-9])?/.+/$",
          "title": "Destination Prefix",
          "type": "string"
        },
        "interval_minutes": {
          "exclusiveMinimum": 0,
          "title": "Interval Minutes",
          "type": "integer"
        },
        "resume_required": {
          "title": "Resume Required",
          "type": "boolean"
        }
      },
      "required": [
        "interval_minutes",
        "destination_prefix",
        "resume_required"
      ],
      "title": "CheckpointContract",
      "type": "object"
    },
    "ComputeProfile": {
      "additionalProperties": false,
      "properties": {
        "accelerator": {
          "enum": [
            "cpu",
            "gpu"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "hourly_rate_usd": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Hourly Rate Usd",
          "type": "string"
        },
        "instance_type": {
          "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+$",
          "title": "Instance Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nodes": {
          "exclusiveMinimum": 0,
          "title": "Nodes",
          "type": "integer"
        },
        "pricing_observed_at": {
          "minLength": 1,
          "title": "Pricing Observed At",
          "type": "string"
        },
        "pricing_source": {
          "minLength": 1,
          "title": "Pricing Source",
          "type": "string"
        },
        "provisioned": {
          "title": "Provisioned",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "instance_type",
        "accelerator",
        "nodes",
        "hourly_rate_usd",
        "pricing_source",
        "pricing_observed_at",
        "provisioned"
      ],
      "title": "ComputeProfile",
      "type": "object"
    },
    "WorkloadProfile": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckpointContract"
            },
            {
              "type": "null"
            }
          ]
        },
        "compute_profile": {
          "minLength": 1,
          "title": "Compute Profile",
          "type": "string"
        },
        "maximum_attempts": {
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "maximum_runtime_hours": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Maximum Runtime Hours",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "name",
        "repository",
        "compute_profile",
        "maximum_runtime_hours",
        "maximum_attempts",
        "checkpoint"
      ],
      "title": "WorkloadProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compute_profiles": {
      "items": {
        "$ref": "#/$defs/ComputeProfile"
      },
      "minItems": 2,
      "title": "Compute Profiles",
      "type": "array"
    },
    "workloads": {
      "items": {
        "$ref": "#/$defs/WorkloadProfile"
      },
      "minItems": 2,
      "title": "Workloads",
      "type": "array"
    }
  },
  "required": [
    "compute_profiles",
    "workloads"
  ],
  "title": "WorkloadCatalog",
  "type": "object"
}
