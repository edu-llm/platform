{
  "$defs": {
    "CheckpointContract": {
      "additionalProperties": false,
      "properties": {
        "destination_prefix": {
          "pattern": "^s3://sbsandbox-intern-[a-z0-9](?:[a-z0-9.-]{0,44}[a-z0-9])?/.+/$",
          "title": "Destination Prefix",
          "type": "string"
        },
        "interval_minutes": {
          "exclusiveMinimum": 0,
          "title": "Interval Minutes",
          "type": "integer"
        },
        "resume_required": {
          "title": "Resume Required",
          "type": "boolean"
        }
      },
      "required": [
        "interval_minutes",
        "destination_prefix",
        "resume_required"
      ],
      "title": "CheckpointContract",
      "type": "object"
    },
    "ComputeProfile": {
      "additionalProperties": false,
      "properties": {
        "accelerator": {
          "enum": [
            "cpu",
            "gpu"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "capacity_block_backed": {
          "default": false,
          "title": "Capacity Block Backed",
          "type": "boolean"
        },
        "hourly_rate_usd": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Hourly Rate Usd",
          "type": "string"
        },
        "instance_type": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z0-9]+$",
          "title": "Instance Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nodes": {
          "exclusiveMinimum": 0,
          "title": "Nodes",
          "type": "integer"
        },
        "pricing_observed_at": {
          "minLength": 1,
          "title": "Pricing Observed At",
          "type": "string"
        },
        "pricing_source": {
          "minLength": 1,
          "title": "Pricing Source",
          "type": "string"
        },
        "provisioned": {
          "title": "Provisioned",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "instance_type",
        "accelerator",
        "nodes",
        "hourly_rate_usd",
        "pricing_source",
        "pricing_observed_at",
        "provisioned"
      ],
      "title": "ComputeProfile",
      "type": "object"
    },
    "WorkloadProfile": {
      "additionalProperties": false,
      "description": "A policy preset, which is a repository, two bounds and a checkpoint contract.\n\nIT NAMED A MACHINE AND THE NAMING WAS A FICTION, WHICH IS WHY THE FIELD IS GONE.\n``compute_profile`` sat here and ``SubmissionInputs.compute_profile`` overrode it\nunconditionally, so what a run landed on was whatever the form said and this value was\nread only when the form left the field empty. Nothing refused a disagreement between\nthe two, and nothing ever could: an override that is refused when it differs is not an\noverride. So a researcher reading ``olmo-core-train-1gpu`` believed the name bound the\nrun to one A10G while the dropdown beside it outranked the name in silence.\n\nRemoving the field rather than enforcing it is the choice that follows from who owns\nthe answer. The machine is the submitter's decision, made per run and priced per run;\nwhat a workload can honestly fix is the contract the codebase keeps -- how long it may\ntake, how many attempts it may have, and whether an interrupted attempt has somewhere\nto resume from. Two entries differing only in a machine were therefore two spellings of\none policy, and the catalog now carries one of each.\n\n:class:`~edullm_platform.contracts.manifest.RunManifest` is unaffected and keeps its\nown ``compute_profile``. It records what a run was submitted with, which is a different\nquestion from what a preset declares, and its serialized shape is content addressed.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckpointContract"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_attempts": {
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "maximum_runtime_hours": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Maximum Runtime Hours",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "name",
        "repository",
        "maximum_runtime_hours",
        "maximum_attempts",
        "checkpoint"
      ],
      "title": "WorkloadProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compute_profiles": {
      "items": {
        "$ref": "#/$defs/ComputeProfile"
      },
      "minItems": 2,
      "title": "Compute Profiles",
      "type": "array"
    },
    "workloads": {
      "items": {
        "$ref": "#/$defs/WorkloadProfile"
      },
      "minItems": 2,
      "title": "Workloads",
      "type": "array"
    }
  },
  "required": [
    "compute_profiles",
    "workloads"
  ],
  "title": "WorkloadCatalog",
  "type": "object"
}
