{
  "$defs": {
    "ApprovalScope": {
      "enum": [
        "organization",
        "team"
      ],
      "title": "ApprovalScope",
      "type": "string"
    },
    "ImageScanPolicy": {
      "additionalProperties": false,
      "description": "Which severities require a recorded exception before an image may run.\n\n``blocking_severities`` is a list rather than a single floor because \"critical and high\"\nand \"critical only\" are both defensible and the difference is a policy decision somebody\nshould be able to make by editing a file. It must not be empty: an empty list would mean\nnothing ever blocks, which is option one wearing option four's clothes, and it would do\nso without anybody recording that the policy had changed.",
      "properties": {
        "blocking_severities": {
          "items": {
            "$ref": "#/$defs/ImageScanSeverity"
          },
          "minItems": 1,
          "title": "Blocking Severities",
          "type": "array"
        }
      },
      "required": [
        "blocking_severities"
      ],
      "title": "ImageScanPolicy",
      "type": "object"
    },
    "ImageScanSeverity": {
      "description": "The severities ECR basic scanning reports, in the order it ranks them.",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFORMATIONAL",
        "UNDEFINED"
      ],
      "title": "ImageScanSeverity",
      "type": "string"
    },
    "PolicyThresholds": {
      "additionalProperties": false,
      "properties": {
        "automatic_below_cost_usd": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Automatic Below Cost Usd",
          "type": "string"
        },
        "automatic_below_runtime_hours": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Automatic Below Runtime Hours",
          "type": "string"
        },
        "routine_maximum_attempts": {
          "minimum": 1,
          "title": "Routine Maximum Attempts",
          "type": "integer"
        },
        "routine_maximum_cost_usd": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Routine Maximum Cost Usd",
          "type": "string"
        },
        "routine_maximum_fanout_size": {
          "minimum": 1,
          "title": "Routine Maximum Fanout Size",
          "type": "integer"
        },
        "routine_maximum_parallelism": {
          "minimum": 1,
          "title": "Routine Maximum Parallelism",
          "type": "integer"
        },
        "routine_maximum_runtime_hours": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Routine Maximum Runtime Hours",
          "type": "string"
        }
      },
      "required": [
        "routine_maximum_cost_usd",
        "routine_maximum_runtime_hours",
        "routine_maximum_attempts",
        "routine_maximum_fanout_size",
        "routine_maximum_parallelism",
        "automatic_below_cost_usd",
        "automatic_below_runtime_hours"
      ],
      "title": "PolicyThresholds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_scope": {
      "$ref": "#/$defs/ApprovalScope"
    },
    "denied_outright": {
      "items": {
        "enum": [
          "unregistered_repository",
          "unregistered_dataset",
          "unregistered_compute_profile",
          "mutable_repository_revision",
          "mutable_image_reference",
          "image_scan_findings_unreviewed"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Denied Outright",
      "type": "array"
    },
    "exception_approver_roles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Exception Approver Roles",
      "type": "array"
    },
    "image_scan": {
      "$ref": "#/$defs/ImageScanPolicy"
    },
    "policy_version": {
      "pattern": "^v[1-9][0-9]*$",
      "title": "Policy Version",
      "type": "string"
    },
    "routine_approver_role": {
      "minLength": 1,
      "title": "Routine Approver Role",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/PolicyThresholds"
    }
  },
  "required": [
    "policy_version",
    "thresholds",
    "image_scan",
    "approval_scope",
    "routine_approver_role",
    "exception_approver_roles",
    "denied_outright"
  ],
  "title": "ApprovalPolicy",
  "type": "object"
}
